# ForgetCheck Environment Configuration Template

# Runtime Environment (development | production | test)
ENVIRONMENT=development

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Persistent Data Storage Directory (default: ./data locally, /var/data in Docker/Render)
DATA_DIR=./data

# Session Signing Secret (Must be strong and unique in production)
SECRET_KEY=forgetcheck-super-secret-key-change-in-prod-382947192847

# Cookie Security (set to true when running behind HTTPS in production)
SECURE_COOKIES=false

# Initial Administrator Credentials (seeded on first startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@ForgetCheck2026!

# Optional: Google Gemini Live AI Provider Configuration
# If omitted, ForgetCheck operates in deterministic Local Extractive Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
